{
  "version": 1,
  "components": {
    "plugins": [
      {
        "id": "core",
        "type": "plugin",
        "source": ".opencode/plugins",
        "destination": "plugins/bazinga",
        "register": "plugins"
      }
    ],
    "agents": [
      {
        "id": "ceo",
        "type": "agent",
        "description": "Tool-less coordinator: briefs, arbitration, the user channel",
        "source": ".opencode/agents/ceo.md",
        "destination": "agents/ceo.md",
        "settings": [
          {
            "key": "experimental.subagent_depth",
            "min": 3,
            "reason": "The CEO launches managers and managers launch workers; OpenCode allows one level of subagents by default"
          }
        ]
      },
      {
        "id": "general-manager",
        "type": "agent",
        "description": "Owns one task: splits it into worker jobs, keeps a to-do list, reports to the CEO",
        "source": ".opencode/agents/general-manager.md",
        "destination": "agents/general-manager.md",
        "settings": [
          {
            "key": "experimental.subagent_depth",
            "min": 2,
            "reason": "A manager launches workers; OpenCode allows one level of subagents by default"
          },
          {
            "key": "experimental.todo",
            "value": true,
            "reason": "A manager keeps its plan in the to-do list (todowrite); OpenCode 2.1 ships that tool off by default"
          }
        ]
      },
      {
        "id": "workers/general",
        "type": "agent",
        "description": "General worker: one narrow job, read/search/edit only, minimal report",
        "source": ".opencode/agents/workers/general.md",
        "destination": "agents/workers/general.md"
      },
      {
        "id": "workers/setup",
        "type": "agent",
        "description": "Setup worker: prepares a manager's new worktree by following the project's worktree guidance",
        "source": ".opencode/agents/workers/setup.md",
        "destination": "agents/workers/setup.md"
      }
    ],
    "skills": [],
    "commands": [],
    "mcps": [
      {
        "id": "git",
        "type": "mcp",
        "description": "Git repository tools: status, diff, log, branches, commits",
        "requires": ["uvx"],
        "requiresHint": "install uv: https://docs.astral.sh/uv/",
        "server": { "type": "local", "command": ["uvx", "mcp-server-git"] }
      },
      {
        "id": "fetch",
        "type": "mcp",
        "description": "Fetch a web page and return it as markdown or text",
        "requires": ["uvx"],
        "requiresHint": "install uv: https://docs.astral.sh/uv/",
        "server": { "type": "local", "command": ["uvx", "mcp-server-fetch"] }
      },
      {
        "id": "context7",
        "type": "mcp",
        "description": "Up-to-date library and framework documentation (remote, no install)",
        "server": { "type": "remote", "url": "https://mcp.context7.com/mcp" }
      },
      {
        "id": "serena",
        "type": "mcp",
        "description": "Semantic code search and editing through language servers",
        "requires": ["serena"],
        "requiresHint": "install it with: uv tool install -p 3.13 serena-agent",
        "server": {
          "type": "local",
          "command": ["serena", "start-mcp-server", "--context", "agent", "--open-web-dashboard", "false"]
        }
      }
    ]
  },
  "profiles": {
    "plugin": ["plugin:core"],
    "full": ["plugin:core", "agent:ceo", "agent:general-manager", "agent:workers/general", "agent:workers/setup"],
    "mcp": ["mcp:git", "mcp:fetch", "mcp:context7", "mcp:serena"]
  }
}
